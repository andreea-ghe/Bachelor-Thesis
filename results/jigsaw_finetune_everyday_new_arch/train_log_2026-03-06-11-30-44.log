  NUM_PC_POINTS: 5000
  MIN_PART_POINT: 30
  MIN_NUM_PART: 2
  MAX_NUM_PART: 20
  SHUFFLE_PARTS: False
  SAMPLE_BY: area
  LENGTH: -1
  TEST_LENGTH: -1
  OVERFIT: -1

MODEL_NAME: jigsaw_finetune_multi_everyday_correct_ds
MODULE: experiments
BATCH_SIZE: 1
NUM_WORKERS: 16
LOG_FILE_NAME: 
MODEL_SAVE_PATH: results/jigsaw_finetune_multi_everyday_correct_ds/model_save
DATASET: breaking_bad.all_piece_matching
PROJECT: jigsaw
TRAIN:
  NUM_EPOCHS: 200
  OPTIMIZER: SGD
  LR: 0.001
  PAIR_LR_MULT: 10.0
  LR_SCHEDULER: cosine
  LR_DECAY: 100.0
  LR_STEP: [10, 20]
  WARMUP_RATIO: 0.0
  CLIP_GRAD: None
  beta1: 0
  beta2: 0.9
  WEIGHT_DECAY: 0.0
  MOMENTUM: 0.9
  VAL_EVERY: 5
  VIS: True
  VAL_SAMPLE_VIS: 5
  LOSS: 
CALLBACK:
  MATCHING_TASK: ['trans']
  CHECKPOINT_MONITOR: val/loss
  CHECKPOINT_MODE: min
LOSS:
EVAL:
GPUS: [0]
PARALLEL_STRATEGY: ddp
FP16: False
CUDNN: False
WEIGHT_FILE: results/jigsaw_finetune_multi_everyday_correct_ds/model_save/last.ckpt
OUTPUT_PATH: results/jigsaw_finetune_multi_everyday_correct_ds
STATISTIC_STEP: 100
RANDOM_SEED: 42
STATS: ./results/jigsaw_finetune_multi_everyday_correct_ds/stats/eval
MODEL:
  ROT_TYPE: rmat
  PC_FEAT_DIM: 128
  AFF_FEAT_DIM: 512
  AFFINITY: aff_dual
  ENCODER: pointnet2_pt.msg.dynamic
  TEST_S_MASK: True
  PC_CLS_METHOD: multi
  PC_NUM_CLS: 2
  SINKHORN_MAXITER: 20
  SINKHORN_TAU: 0.05
  TF_NUM_HEADS: 8
  TF_NUM_SAMPLE: 16
  USE_PAIR_BIAS: False
  USE_DOUBLE_ATTN: False
  LOSS:
    w_cls_loss: 1.0
    w_mat_loss: 0.0
    mat_epoch: 9
    w_rig_loss: 0.0
    rig_epoch: 199
